*__pycache__
*__pycache__/*
*pyc
__pychace__/*

# Webapp runtime files
.snakemake_run.json
*.log
.config_backups/
.sessions/
*.cpython

# User-specific configs (use config.template.yaml as starting point).
# Every config.*.yaml is personal (paths/account/email); only the templates ship.
config.yaml
config.*.yaml
# ...including backups/renames like config.yaml.bak or config.yaml.pre-assets,
# which `config.*.yaml` does NOT match (the extension is no longer .yaml).
config.yaml.*
!config.template.yaml
!config.kempner.template.yaml

# Local virtual environments (e.g. scripts/uniprot_fetch/.venv)
.venv/
**/.venv/

# Snakemake state dir (now lives inside the output dir; ignore everywhere)
.snakemake/
**/.snakemake/
