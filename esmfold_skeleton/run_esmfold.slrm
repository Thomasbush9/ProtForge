#!/bin/bash
#SBATCH --job-name=esmfold
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus-per-node=1
#SBATCH --mem=32GB
#SBATCH --time=2:00:00
#SBATCH --output=/tmp/%x.%j.out

set -euo pipefail

: "${FASTA_DIR:?Need FASTA_DIR exported from sbatch}"
: "${OUTPUT_DIR:?Need OUTPUT_DIR exported from sbatch}"
: "${ESMFOLD_ENV_PREFIX:?Need ESMFOLD_ENV_PREFIX exported from sbatch}"
: "${ESMFOLD_CACHE_DIR:?Need ESMFOLD_CACHE_DIR exported from sbatch}"
: "${ESMFOLD_SCRIPT:?Need ESMFOLD_SCRIPT (absolute path to run_esmfold.py)}"

module load python/3.12.8-fasrc01 gcc/14.2.0-fasrc01 cuda/12.9.1-fasrc01 cudnn/9.10.2.21_cuda12-fasrc01

set +u
source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate "$ESMFOLD_ENV_PREFIX"
set -u

export HF_HOME="$ESMFOLD_CACHE_DIR"
export HF_HUB_OFFLINE=1

echo "FASTA_DIR=$FASTA_DIR"
echo "OUTPUT_DIR=$OUTPUT_DIR"
echo "HF_HOME=$HF_HOME"

python "$ESMFOLD_SCRIPT" \
    --fasta-dir "$FASTA_DIR" \
    --output-dir "$OUTPUT_DIR" \
    --cache-dir "$ESMFOLD_CACHE_DIR"
