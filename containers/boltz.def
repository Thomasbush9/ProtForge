Bootstrap: docker
From: python:3.12-slim


# Singularity Image for Boltz 
#
%files 
# Sections where you can specify which files from host you want to copy in the Image.
# For bigger files (e.g., models weights) you can: 
# --bind host_path:image_path 

%post 
#Download section -> Ubuntu uses apt package manager 

    apt-get update 
    apt-get install -y --no-install-recommends \
    git build-essential 

    # install boltz: 
    pip install --no-cache-dir --upgrade pip 
    # we install first torch with a specific version for the cuda version we are using
    pip install --no-cache-dir torch torchvision \
    --index-url https://download.pytorch.org/whl/cu128
    pip install --no-cache-dir "boltz[cuda]" 


%environment
# It defines environment variables that will be set at runtime -> not available at build time 
# if you need envs available at build time define them in the 'post' section 



%runscript
# they are commands that are run when the container is invoked 
    exec boltz "$@"


%test
# it runs at the end of the build process -> useful to test the container (imports and etc. )
    echo "Testing Import Boltz"
    python -c "import boltz; import torch; print(torch.__version__); print('Boltz imported')"




%labels




%help
