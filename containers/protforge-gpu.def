Bootstrap: docker
From: ubuntu:22.04

# ProtForge GPU container — single image for all GPU stages
# (MSA / Boltz / ESM-C / ESMFold). PDAnalysis (ES) is excluded; it ships
# in a separate MPI image.
#
# Bake list:
#   - Tools: boltz, colabfold_search, mmseqs2, esm SDK, transformers
#
# NOT baked (bind-mounted at runtime):
#   - ColabFold MSA databases (~700 GB)  -> /data/colabfold_db
#   - Boltz model checkpoint  (~5 GB)    -> /data/boltz_db
#   - ESM/ESMFold HF cache              -> /models/hf
#
# Why ubuntu:22.04 and NOT nvidia/cuda as the base:
#   - PyTorch's `cu124` wheels ship their own libcudart / libcublas /
#     libcudnn / libcurand etc. under torch/lib/. Re-installing CUDA at
#     the base layer is ~2 GB of duplicated libraries that PyTorch ignores.
#   - The NVIDIA driver libs (libnvidia-*.so, libcuda.so.1) are injected
#     at runtime by `singularity exec --nv` from the host driver. The
#     container doesn't need its own driver, and we never compile CUDA
#     code at runtime (Triton ships its own ptxas).
#   - Host modules `cuda/...`/`cudnn/...` from the Kempner module system
#     are unused in container mode — they only matter for the bash/conda
#     fallback path (see workflow/rules/*.smk `else` branches).
#   - The non-CUDA base saves ~2 GB of image size and removes the CUDA
#     version pin from a layer that doesn't actually need it.
#
%files
    # Copied last so codebase edits invalidate only the final layer.
    # NOTE: paths are relative to the build context (repo root).
    . /opt/protforge

%post
    set -eux

    # -----------------------------------------------------------------
    # Layer 1: system deps (changes ~never)
    # -----------------------------------------------------------------
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends \
        python3 python3-pip python3-venv \
        git wget curl ca-certificates \
        build-essential cmake \
        libgomp1
    rm -rf /var/lib/apt/lists/*
    ln -sf /usr/bin/python3 /usr/local/bin/python

    # -----------------------------------------------------------------
    # Layer 2: mmseqs2 binary (changes when bumping MMseqs2)
    # -----------------------------------------------------------------
    cd /opt
    wget -q https://mmseqs.com/latest/mmseqs-linux-avx2.tar.gz
    tar xzf mmseqs-linux-avx2.tar.gz
    rm mmseqs-linux-avx2.tar.gz
    ln -sf /opt/mmseqs/bin/mmseqs /usr/local/bin/mmseqs

    # -----------------------------------------------------------------
    # Layer 3: Python tools (changes when bumping any tool version)
    # -----------------------------------------------------------------
    pip3 install --no-cache-dir --upgrade pip setuptools wheel

    # PyTorch first (cu124 wheels). All downstream tools pull torch as a dep,
    # so installing it explicitly here pins the version.
    #
    # The cu124 wheels are self-contained: they bundle libcudart/libcublas/
    # libcudnn under torch/lib/. That's why this image starts from
    # ubuntu:22.04 (not nvidia/cuda) — torch carries the CUDA runtime, and
    # `singularity exec --nv` injects the driver libs from the host.
    pip3 install --no-cache-dir \
        torch torchvision torchaudio \
        --index-url https://download.pytorch.org/whl/cu124

    # Boltz (structure prediction)
    pip3 install --no-cache-dir boltz

    # ESM-C SDK (used by run_esm.py)
    # NB: esm SDK's esm/sdk/base_forge_client.py imports httpx unconditionally
    # even when only the local API is used. pip metadata misses httpx as a dep
    # in some releases — install explicitly to be safe.
    pip3 install --no-cache-dir esm httpx

    # ESMFold via HuggingFace transformers (run_esmfold.py uses EsmForProteinFolding)
    pip3 install --no-cache-dir \
        "transformers>=4.40" accelerate \
        biopython numpy scipy

    # ColabFold (provides colabfold_search; we skip the alphafold/jax extras
    # since we only run the MSA-search side, not structure prediction)
    pip3 install --no-cache-dir \
        "colabfold @ git+https://github.com/sokrypton/ColabFold"

    # ProtForge runtime deps (whatever the scripts import)
    pip3 install --no-cache-dir \
        pyyaml pandas tqdm

    # Pin numpy to the compatible window for boltz + colabfold + numba.
    # - colabfold (current main) declares: numpy>=2.0.2,<3.0
    # - numba (transitive dep of boltz) refuses: NumPy 2.2+ (runtime check)
    # - boltz pyproject declares: numpy>=1.26,<2.0 (DEclARED only; the
    #   actual runtime constraint is numba's, which is satisfied by 2.0.x)
    # Intersection: 2.0.2 <= numpy < 2.1. Force-install so the colabfold
    # step's 2.2.x doesn't stick. Pip will warn about boltz's <2.0 — safe
    # to ignore (the runtime works; the wheel just over-declared).
    pip3 install --no-cache-dir --force-reinstall \
        "numpy>=2.0.2,<2.1"

    # Model weights are intentionally not baked into the image. Create the
    # standard mount points so `singularity exec -B host:/models/hf:ro` works
    # consistently across clusters.
    mkdir -p /models/hf /models/torch /data/protforge

%environment
    # ProtForge cache root: host bind-mount target convention.
    # Override at runtime with: singularity exec --env PROTFORGE_HOME=/path ...
    export PROTFORGE_HOME=${PROTFORGE_HOME:-/data/protforge}

    # Default model caches are host bind-mount targets. Populate them with
    # scripts/download_models.py before running compute jobs.
    export HF_HOME=${HF_HOME:-/models/hf}
    export TORCH_HOME=${TORCH_HOME:-/models/torch}

    # Bind-mount targets that the rules expect (host paths bound to these):
    #   /data/colabfold_db   <- ColabFold MSA DBs
    #   /data/boltz_db       <- Boltz model checkpoint dir
    #   /models/hf           <- ESM-C / ESMFold HF cache

    # Make sure ProtForge code is importable
    export PYTHONPATH=/opt/protforge${PYTHONPATH:+:$PYTHONPATH}

%runscript
    # Default: forward args to whatever was requested.
    # Usage:
    #   singularity exec --nv protforge-gpu.sif boltz predict ...
    #   singularity exec --nv protforge-gpu.sif colabfold_search ...
    exec "$@"

%labels
    Author thomasbush52@gmail.com
    Version 0.1.0
    Description ProtForge GPU container (MSA + Boltz + ESM-C + ESMFold)

%help
    ProtForge GPU container — bundles all GPU-stage tools for the ProtForge
    pipeline. Model weights and databases are bind-mounted at runtime.

    GPU model: ubuntu:22.04 base + torch+cu124 wheels (which ship their own
    CUDA runtime). At runtime, `singularity exec --nv` injects the host's
    NVIDIA driver libs. No host `module load cuda/cudnn` is needed in
    container mode — those modules only apply to the bash/conda fallback.

    Quickstart (Kempner):
        singularity exec --nv \
            -B /n/holylfs06/.../colabfold/databases:/data/colabfold_db \
            -B /n/holylfs06/.../boltz/boltz_db:/data/boltz_db \
            -B /n/holylfs06/.../protforge/models/hf:/models/hf:ro \
            -B "$PWD":"$PWD" \
            protforge-gpu.sif \
            <stage_command>

    See containers/README.md for full bind-mount setup.
