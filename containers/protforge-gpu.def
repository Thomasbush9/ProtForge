Bootstrap: docker
From: ubuntu:22.04

# ProtForge GPU container — single image for all GPU stages
# (MSA / Boltz / ESM-C / ESMFold). PDAnalysis (ES) is excluded; it ships
# in a separate MPI image.
#
# Bake list:
#   - Tools : boltz, colabfold_search, mmseqs2, esm SDK, transformers
#   - Weights : esmc_600m (~2.5 GB), facebook/esmfold_v1 (~4 GB)
#
# NOT baked (bind-mounted at runtime):
#   - ColabFold MSA databases (~700 GB)  -> /data/colabfold_db
#   - Boltz model checkpoint  (~5 GB)    -> /data/boltz_db
#
# Why ubuntu:22.04 and NOT nvidia/cuda as the base:
#   - PyTorch's `cu124` wheels ship their own libcudart / libcublas /
#     libcudnn / libcurand etc. under torch/lib/. Re-installing CUDA at
#     the base layer is ~2 GB of duplicated libraries that PyTorch ignores.
#   - The NVIDIA driver libs (libnvidia-*.so, libcuda.so.1) are injected
#     at runtime by `singularity exec --nv` from the host driver. The
#     container doesn't need its own driver, and we never compile CUDA
#     code at runtime (Triton ships its own ptxas).
#   - Host modules `cuda/...`/`cudnn/...` from the Kempner module system
#     are unused in container mode — they only matter for the bash/conda
#     fallback path (see workflow/rules/*.smk `else` branches).
#   - The non-CUDA base saves ~2 GB of image size and removes the CUDA
#     version pin from a layer that doesn't actually need it.
#
# Layer order matters: each %post block roughly = one Docker layer.
# Order matches "changes least often -> changes most often" so iterating
# on the codebase doesn't redownload model weights.

%setup
    # Pre-create the bind-mount target for the optional HF_TOKEN secret
    # file. Singularity does NOT auto-create file mountpoints — if the
    # destination doesn't exist in the rootfs by the time %post starts,
    # `singularity build --bind file:dest` fails with
    #   "destination ... doesn't exist in container".
    # We always create an empty mode-600 placeholder; %post uses `-s`
    # (non-empty test) so the build still works with no token (and just
    # falls through to the anonymous-download path).
    mkdir -p "${SINGULARITY_ROOTFS}/run/secrets"
    : > "${SINGULARITY_ROOTFS}/run/secrets/hf_token"
    chmod 600 "${SINGULARITY_ROOTFS}/run/secrets/hf_token"

%files
    # Copied last so codebase edits invalidate only the final layer.
    # NOTE: paths are relative to the build context (repo root).
    . /opt/protforge

%post
    set -eux

    # -----------------------------------------------------------------
    # Layer 1: system deps (changes ~never)
    # -----------------------------------------------------------------
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends \
        python3 python3-pip python3-venv \
        git wget curl ca-certificates \
        build-essential cmake \
        libgomp1
    rm -rf /var/lib/apt/lists/*
    ln -sf /usr/bin/python3 /usr/local/bin/python

    # -----------------------------------------------------------------
    # Layer 2: mmseqs2 binary (changes when bumping MMseqs2)
    # -----------------------------------------------------------------
    cd /opt
    wget -q https://mmseqs.com/latest/mmseqs-linux-avx2.tar.gz
    tar xzf mmseqs-linux-avx2.tar.gz
    rm mmseqs-linux-avx2.tar.gz
    ln -sf /opt/mmseqs/bin/mmseqs /usr/local/bin/mmseqs

    # -----------------------------------------------------------------
    # Layer 3: Python tools (changes when bumping any tool version)
    # -----------------------------------------------------------------
    pip3 install --no-cache-dir --upgrade pip setuptools wheel

    # PyTorch first (cu124 wheels). All downstream tools pull torch as a dep,
    # so installing it explicitly here pins the version.
    #
    # The cu124 wheels are self-contained: they bundle libcudart/libcublas/
    # libcudnn under torch/lib/. That's why this image starts from
    # ubuntu:22.04 (not nvidia/cuda) — torch carries the CUDA runtime, and
    # `singularity exec --nv` injects the driver libs from the host.
    pip3 install --no-cache-dir \
        torch torchvision torchaudio \
        --index-url https://download.pytorch.org/whl/cu124

    # Boltz (structure prediction)
    pip3 install --no-cache-dir boltz

    # ESM-C SDK (used by run_esm.py)
    # NB: esm SDK's esm/sdk/base_forge_client.py imports httpx unconditionally
    # even when only the local API is used. pip metadata misses httpx as a dep
    # in some releases — install explicitly to be safe.
    pip3 install --no-cache-dir esm httpx

    # ESMFold via HuggingFace transformers (run_esmfold.py uses EsmForProteinFolding)
    pip3 install --no-cache-dir \
        "transformers>=4.40" accelerate \
        biopython numpy scipy

    # ColabFold (provides colabfold_search; we skip the alphafold/jax extras
    # since we only run the MSA-search side, not structure prediction)
    pip3 install --no-cache-dir \
        "colabfold @ git+https://github.com/sokrypton/ColabFold"

    # ProtForge runtime deps (whatever the scripts import)
    pip3 install --no-cache-dir \
        pyyaml pandas tqdm

    # Pin numpy to the compatible window for boltz + colabfold + numba.
    # - colabfold (current main) declares: numpy>=2.0.2,<3.0
    # - numba (transitive dep of boltz) refuses: NumPy 2.2+ (runtime check)
    # - boltz pyproject declares: numpy>=1.26,<2.0 (DEclARED only; the
    #   actual runtime constraint is numba's, which is satisfied by 2.0.x)
    # Intersection: 2.0.2 <= numpy < 2.1. Force-install so the colabfold
    # step's 2.2.x doesn't stick. Pip will warn about boltz's <2.0 — safe
    # to ignore (the runtime works; the wheel just over-declared).
    pip3 install --no-cache-dir --force-reinstall \
        "numpy>=2.0.2,<2.1"

    # -----------------------------------------------------------------
    # Layer 4: model weights (changes only when bumping a model)
    #
    # Bake into /opt/weights so the image works offline. At runtime,
    # HF_HOME / cache_dir env vars can be overridden to point elsewhere.
    # -----------------------------------------------------------------
    mkdir -p /opt/weights/hf /opt/weights/torch

    # Optional HF_TOKEN: bind-mount a token file at /run/secrets/hf_token
    # via `build.sh --hf-token` (or by exporting HF_TOKEN before build.sh).
    # Authenticated downloads get a much higher per-IP rate limit on HF
    # Hub — Kempner's shared egress IPs hit the anon limit fast.
    #
    # Trace is suppressed around the read so the token never lands in the
    # build log, then re-enabled. The token is unset at the end of this
    # block so it doesn't appear in any later command echoes either.
    { set +x; } 2>/dev/null
    if [ -s /run/secrets/hf_token ]; then
        export HF_TOKEN="$(cat /run/secrets/hf_token)"
        echo "[info] HF_TOKEN loaded from /run/secrets/hf_token (authenticated downloads)"
    else
        echo "[info] no HF_TOKEN provided; downloading anonymously (rate-limit risk)"
    fi
    set -x

    # ESMFold weights via huggingface_hub.snapshot_download.
    #
    # Why not from_pretrained: calling
    # `EsmForProteinFolding.from_pretrained('facebook/esmfold_v1',
    # use_safetensors=True)` at build time leaves the cache snapshot dir with
    # ONLY tokenizer/config files — no weight file. At runtime that triggers
    # transformers' auto_conversion path, which tries to hit huggingface.co
    # and dies under HF_HUB_OFFLINE=1 (smoke step 6 failure). Most likely
    # cause: facebook/esmfold_v1 doesn't ship model.safetensors and the
    # use_safetensors=True branch never materialises the .bin into the
    # snapshot symlink farm.
    #
    # snapshot_download is the contract we actually want: pull a fixed set
    # of files into the HF cache as real symlinks under
    # models--facebook--esmfold_v1/snapshots/<sha>/, with no Python-object
    # instantiation involved.
    #
    # allow_patterns: pytorch_model.bin (8.44 GB, the only weight artifact
    # facebook/esmfold_v1 actually publishes) plus config + tokenizer.
    # Explicitly excluding *.safetensors keeps the image one weight-file
    # lean even if the upstream repo adds a safetensors mirror later;
    # EsmForProteinFolding loads .bin fine.
    HF_HOME=/opt/weights/hf python3 -c "\
from huggingface_hub import snapshot_download; \
snapshot_download(\
    repo_id='facebook/esmfold_v1', \
    allow_patterns=['pytorch_model.bin', '*.json', '*.txt', '*.model'], \
)"

    # ESM-C 600M weights via huggingface_hub.snapshot_download.
    #
    # Why not ESMC.from_pretrained: that call both downloads the snapshot
    # AND instantiates the 600M-param model in RAM (~2.5 GB weights + model
    # graph). On memory-constrained build hosts (Kempner login nodes have
    # tight per-user cgroup limits, typically OOM-killing builds around
    # this step with exit 137), the instantiation kills the build right
    # after the download succeeded.
    #
    # The SDK's own implementation does
    #   snapshot_download(repo_id="EvolutionaryScale/esmc-600m-2024-12")
    # (see esm/utils/constants/esm3.py) and then loads weights from
    #   <snapshot_dir>/data/weights/esmc_600m_2024_12_v0.pth.
    # Doing just the snapshot_download here populates the same HF cache
    # layout the SDK looks up at runtime — when ESMC.from_pretrained is
    # eventually called from rules, snapshot_download is a cache hit and
    # the .pth load happens with the GPU already available.
    HF_HOME=/opt/weights/hf python3 -c "\
from huggingface_hub import snapshot_download; \
snapshot_download(repo_id='EvolutionaryScale/esmc-600m-2024-12')"

    # Scrub the build-time token so it can't leak into later command
    # echoes or end up baked into anything written to /opt during the
    # build. The image's %environment doesn't set HF_TOKEN, so runtime
    # is unaffected.
    { set +x; } 2>/dev/null
    unset HF_TOKEN
    set -x

    chmod -R a+rX /opt/weights

%environment
    # ProtForge cache root: host bind-mount target convention.
    # Override at runtime with: singularity exec --env PROTFORGE_HOME=/path ...
    export PROTFORGE_HOME=${PROTFORGE_HOME:-/data/protforge}

    # Default HF cache to the baked location. Override (e.g. to /data/...) when
    # you want to use external/newer weights.
    export HF_HOME=${HF_HOME:-/opt/weights/hf}
    export TORCH_HOME=${TORCH_HOME:-/opt/weights/torch}

    # Bind-mount targets that the rules expect (host paths bound to these):
    #   /data/colabfold_db   <- ColabFold MSA DBs
    #   /data/boltz_db       <- Boltz model checkpoint dir

    # Make sure ProtForge code is importable
    export PYTHONPATH=/opt/protforge${PYTHONPATH:+:$PYTHONPATH}

%runscript
    # Default: forward args to whatever was requested.
    # Usage:
    #   singularity exec --nv protforge-gpu.sif boltz predict ...
    #   singularity exec --nv protforge-gpu.sif colabfold_search ...
    exec "$@"

%labels
    Author thomasbush52@gmail.com
    Version 0.1.0
    Description ProtForge GPU container (MSA + Boltz + ESM-C + ESMFold)

%help
    ProtForge GPU container — bundles all GPU-stage tools and default model
    weights for the ProtForge pipeline.

    GPU model: ubuntu:22.04 base + torch+cu124 wheels (which ship their own
    CUDA runtime). At runtime, `singularity exec --nv` injects the host's
    NVIDIA driver libs. No host `module load cuda/cudnn` is needed in
    container mode — those modules only apply to the bash/conda fallback.

    Quickstart (Kempner):
        singularity exec --nv \
            -B /n/holylfs06/.../colabfold/databases:/data/colabfold_db \
            -B /n/holylfs06/.../boltz/boltz_db:/data/boltz_db \
            -B "$PWD":"$PWD" \
            protforge-gpu.sif \
            <stage_command>

    See containers/README.md for full bind-mount setup.
