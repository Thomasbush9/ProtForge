Bootstrap: docker
From: nvidia/cuda:12.8.1-cudnn-devel-ubuntu24.04
#here we select ubunto from nvidia to install the cuda libraries + exec. from Nvidia 
# Singularity Image for Boltz 
#
%files 
# Sections where you can specify which files from host you want to copy in the Image.
# For bigger files (e.g., models weights) you can: 
# --bind host_path:image_path 
    run_esmfold2.py /opt/run_esmfold2.py 

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends \
        python3 python3-pip python3-dev python-is-python3 \
        git build-essential ca-certificates \
        cmake ninja-build pkg-config libgomp1
    rm -rf /var/lib/apt/lists/*

# Ubuntu 24.04 PEP 668: one env var for all pip installs in this image build
    export PIP_BREAK_SYSTEM_PACKAGES=1

    # build backends for --no-build-isolation (transformer_engine, git deps)
    pip install --no-cache-dir packaging setuptools wheel

    # Pin torch 2.8 so flash-attn wheel tag (cu12torch2.8) matches; cu128 index alone may resolve 2.7.x
    pip install --no-cache-dir torch==2.8.0 torchvision \
        --index-url https://download.pytorch.org/whl/cu128
    # install transformer Engine; PyTorch ext compiles from source against torch + nvcc/cuDNN
    export NVTE_FRAMEWORK=pytorch
    export MAX_JOBS=4
    pip install --no-cache-dir --no-build-isolation "transformer_engine[pytorch]"
    pip install --no-cache-dir --no-build-isolation xformers

    # Prebuilt FA2 wheel (no nvcc compile — avoids OOM on build nodes). Must match torch + ABI.
    pip install --no-cache-dir psutil ninja
    python3 -c "import torch; print('torch for flash-attn wheel:', torch.__version__, 'cxx11_abi', torch._C._GLIBCXX_USE_CXX11_ABI)"
    pip install --no-cache-dir \
        "https://github.com/Dao-AILab/flash-attention/releases/download/v2.8.3/flash_attn-2.8.3+cu12torch2.8cxx11abiTRUE-cp312-cp312-linux_x86_64.whl"

    # esm pins Biohub transformers fork (esmfold2); do not install PyPI transformers separately
    # warning: torch cu128 matches Kempner (no cuda 13 driver yet)
    pip install --no-cache-dir "esm@git+https://github.com/Biohub/esm.git@c94ed8d"

%environment
    export HF_HOME=${HF_HOME:-/models/hf}
    export HF_HUB_OFFLINE=${HF_HUB_OFFLINE:-1}
    export TRANSFORMERS_OFFLINE=${TRANSFORMERS_OFFLINE:-1}
    export SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt


%runscript
# they are commands that are run when the container is invoked 
    python3 /opt/run_esmfold2.py "$@"


%test
# it runs at the end of the build process -> useful to test the container (imports and etc. )
    echo "Testing torch version:"
    python -c "import torch; print(torch.__version__, 'cuda', torch.version.cuda)"

    echo "Testing imports:"

    python -c "import flash_attn; from transformers.models.esmfold2.modeling_esmfold2 import ESMFold2Model; print('flash_attn', flash_attn.__version__); print('ESMFold2Model Imported')"


    echo "Tests passed."



%labels




%help
