Bootstrap: docker
From: nvidia/cuda:12.8.1-cudnn-devel-ubuntu24.04
#here we select ubunto from nvidia to install the cuda libraries + exec. from Nvidia 
# Singularity Image for Boltz 
#
%files 
# Sections where you can specify which files from host you want to copy in the Image.
# For bigger files (e.g., models weights) you can: 
# --bind host_path:image_path 
    run_esmfold2.py /opt/run_esmfold2.py 

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends \
        python3 python3-pip python3-dev python-is-python3 \
        git build-essential ca-certificates \
        cmake ninja-build pkg-config libgomp1
    rm -rf /var/lib/apt/lists/*

# Ubuntu 24.04 PEP 668: one env var for all pip installs in this image build
    export PIP_BREAK_SYSTEM_PACKAGES=1

    # build backends for --no-build-isolation (transformer_engine, git deps)
    pip install --no-cache-dir packaging setuptools wheel

    # CUDA 12.8 only (Kempner: no CUDA 13 driver). Pin torch first.
    # xformers/flash-attn use --no-deps; esm uses -c constraints.txt (not --no-build-isolation).
    TORCH_CU128_INDEX="https://download.pytorch.org/whl/cu128"
    pip install --no-cache-dir torch==2.8.0 torchvision \
        --index-url "${TORCH_CU128_INDEX}"

    pip install --no-cache-dir psutil ninja

    # Prebuilt FA2 wheel — must match pinned torch 2.8 + cxx11 ABI (--no-deps: never touch torch)
    python3 -c "import torch; print('torch for flash-attn:', torch.__version__, 'cxx11_abi', torch._C._GLIBCXX_USE_CXX11_ABI)"
    pip install --no-cache-dir --no-deps \
        "https://github.com/Dao-AILab/flash-attention/releases/download/v2.8.3/flash_attn-2.8.3+cu12torch2.8cxx11abiTRUE-cp312-cp312-linux_x86_64.whl"

    export NVTE_FRAMEWORK=pytorch
    export MAX_JOBS=4
    pip install --no-cache-dir --no-build-isolation "transformer_engine[pytorch]"

    # xformers 0.0.32 matches torch 2.8.0+cu128 (0.0.35 expects torch 2.10 — C++ ext won't load)
    pip install --no-cache-dir --no-deps "xformers==0.0.32" --index-url "${TORCH_CU128_INDEX}"

    # esm: let pip install pyproject deps (incl. Biohub transformers); constrain torch so it stays 2.8.0+cu128
    printf '%s\n' 'torch==2.8.0' > /tmp/pip-constraints.txt
    pip install --no-cache-dir -c /tmp/pip-constraints.txt \
        "esm@git+https://github.com/Biohub/esm.git@c94ed8d"

%environment
    export HF_HOME=${HF_HOME:-/models/hf}
    export HF_HUB_OFFLINE=${HF_HUB_OFFLINE:-1}
    export TRANSFORMERS_OFFLINE=${TRANSFORMERS_OFFLINE:-1}
    export SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt


%runscript
# they are commands that are run when the container is invoked 
    python3 /opt/run_esmfold2.py "$@"


%test
    set -e
    echo "Testing torch + flash-attn + esmfold2 imports..."
    python3 -c "
import torch
v = torch.__version__
assert '+cu128' in v, f'torch must stay cu128, got {v}'
assert '+cu130' not in v, f'refusing cu130 torch: {v}'
print('torch', v, 'cuda', torch.version.cuda)
import flash_attn
import xformers
assert xformers.__version__.startswith('0.0.32'), f'xformers must match torch 2.8, got {xformers.__version__}'
import xformers.ops.fmha  # fails if C++ ext missing
from transformers.models.esmfold2.modeling_esmfold2 import ESMFold2Model
print('flash_attn', flash_attn.__version__)
print('xformers', xformers.__version__)
print('ESMFold2Model ok')
"
    echo "Tests passed."



%labels




%help
