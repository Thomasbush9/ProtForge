Bootstrap: docker
From: nvidia/cuda:12.8.1-cudnn-devel-ubuntu24.04
#here we select ubunto from nvidia to install the cuda libraries + exec. from Nvidia 
# Singularity Image for Boltz 
#
%files 
# Sections where you can specify which files from host you want to copy in the Image.
# For bigger files (e.g., models weights) you can: 
# --bind host_path:image_path 
    run_esmfold2.py /opt/run_esmfold2.py 

%post 
#Download section -> Ubuntu uses apt package manager 
# here we install python3 as we  have not downloaded the image
    apt-get update 
    apt-get install -y --no-install-recommends \
    python3 python3-pip python3-dev python-is-python3 \
    git build-essential ca-certificates

# Ubuntu 24.04 PEP 668: one env var for all pip installs in this image build
    export PIP_BREAK_SYSTEM_PACKAGES=1

    pip install --no-cache-dir --upgrade pip

    pip install --no-cache-dir torch torchvision \
        --index-url https://download.pytorch.org/whl/cu128
    # install transformer Engine; PyTorch ext compiles from source against torch + nvcc/cuDNN
    export NVTE_FRAMEWORK=pytorch
    export MAX_JOBS=4
    pip install --no-cache-dir --no-build-isolation "transformer_engine[pytorch]"
    pip install --no-cache-dir --no-build-isolation "transformers>=4.40"

    # warning: currently we install torch with cuda 12.8 as Kempner cluster does not have cuda13 driver
    pip install --no-cache-dir "esm@git+https://github.com/Biohub/esm.git@c94ed8d"

%environment
    export HF_HOME=${HF_HOME:-/models/hf}
    export HF_HUB_OFFLINE=${HF_HUB_OFFLINE:-1}
    export TRANSFORMERS_OFFLINE=${TRANSFORMERS_OFFLINE:-1}
    export SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt


%runscript
# they are commands that are run when the container is invoked 
    python3 /opt/run_esmfold2.py "$@"


%test
# it runs at the end of the build process -> useful to test the container (imports and etc. )
    echo "Testing torch version:"
    python -c "import torch; print(torch.__version__, 'cuda', torch.version.cuda)"

    echo "Testing imports:"

    python -c "from transformers.models.esmfold2.modeling_esmfold2 import ESMFold2Model; print('ESMFold2Model Imported')"


    echo "Tests passed."



%labels




%help
